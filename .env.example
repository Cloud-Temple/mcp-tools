# =============================================================================
# Configuration MCP Tools
# =============================================================================

# --- WAF (Caddy + Coraza) ---
WAF_PORT=8082

# --- Serveur MCP ---
MCP_SERVER_NAME=mcp-tools
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8050
MCP_SERVER_DEBUG=false

# --- Authentification ---
# Clé utilisée pour les requêtes administratives / bypass token S3
ADMIN_BOOTSTRAP_KEY=change_me_in_production

# --- Stockage S3 Dell ECS (Gestion tokens + Tool files) ---
# Dell ECS Cloud Temple : config hybride SigV2/SigV4 automatique
# SigV2 pour données (PUT/GET/DELETE), SigV4 pour métadonnées (HEAD/LIST)
# Le tool files utilise ces valeurs par défaut (overridable par paramètre)
S3_ENDPOINT_URL=https://s3.fr1.cloud-temple.com
S3_ACCESS_KEY_ID=AKIA_YOUR_KEY
S3_SECRET_ACCESS_KEY=your_secret
S3_BUCKET_NAME=mcp-tools
S3_REGION_NAME=fr1

# --- Perplexity ---
# Clé API pour les outils perplexity_*
PERPLEXITY_API_KEY=pplx_...
PERPLEXITY_MODEL=sonar-reasoning-pro
PERPLEXITY_API_URL=https://api.perplexity.ai
# Timeout dédié pour les appels Perplexity API (sonar-reasoning-pro prend 60-120s en detailed)
# PERPLEXITY_TIMEOUT=600

# --- Limites globales d'exécution ---
TOOL_MAX_OUTPUT_CHARS=50000
TOOL_MAX_CONCURRENT=20
TOOL_DEFAULT_TIMEOUT=600    # Timeout par défaut des outils (secondes). Perplexity detailed prend 60-120s.
TOOL_MAX_TIMEOUT=600        # Timeout maximum autorisé

# --- Observabilité (buffer local de /admin et system_activity) ---
# Les événements restent sans payload ni secret. Ces bornes ne remplacent pas
# une archive durable ; elles rendent visible toute éviction locale.
ACTIVITY_MAX_EVENTS=5000
ACTIVITY_MAX_AGE_SECONDS=86400

# --- Sandbox Docker (tool shell) ---
# Image Docker utilisée pour l'exécution isolée des commandes shell
SANDBOX_IMAGE=mcp-tools-sandbox
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=10
SANDBOX_TMPFS_SIZE=32m
SANDBOX_MAX_TIMEOUT=30
# Mettre à false pour exécuter en local (dev sans Docker)
SANDBOX_ENABLED=true
# DNS pour les conteneurs sandbox réseau (séparés par virgule)
# En production Cloud Temple : utiliser le DNS interne
SANDBOX_DNS=8.8.8.8,8.8.4.4

# --- Email (Phase 2 - Optionnel) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=mon_user
# SMTP_PASSWORD=mon_password

# =============================================================================
# MCP Cybersec v0.7.0 — SERVICE DISTINCT
# =============================================================================
# Ces valeurs ne doivent PAS reprendre les tokens, bucket ou secrets de
# mcp-tools. En production, elles sont injectées par Vault Agent ; ce fichier
# ne sert qu'à décrire les noms attendus pour la recette locale.

CYBERSEC_WAF_PORT=8081
CYBERSEC_SITE_ADDRESS=:8080
CYBERSEC_MCP_SERVER_NAME=mcp-cybersec
CYBERSEC_MCP_SERVER_HOST=0.0.0.0
CYBERSEC_MCP_SERVER_PORT=8051
CYBERSEC_ADMIN_BOOTSTRAP_KEY=change_me_in_production

# Bucket et identifiants S3 propres au produit cybersec.
CYBERSEC_S3_ENDPOINT_URL=https://s3.fr1.cloud-temple.com
CYBERSEC_S3_ACCESS_KEY_ID=CYBERSEC_YOUR_KEY
CYBERSEC_S3_SECRET_ACCESS_KEY=cybersec_secret
CYBERSEC_S3_BUCKET_NAME=mcp-cybersec
CYBERSEC_S3_REGION_NAME=fr1
CYBERSEC_S3_PREFIX=mcp-cybersec
CYBERSEC_S3_CONNECT_TIMEOUT_SECONDS=3
CYBERSEC_S3_READ_TIMEOUT_SECONDS=5
CYBERSEC_S3_TOTAL_MAX_ATTEMPTS=2

# Répertoire temporaire hôte dédié aux runners Docker. Préprovisionner en
# mode 01777 avant docker compose ; aucun artefact de campagne n'y persiste.
CYBERSEC_RUNTIME_HOST_DIR=/tmp/mcp-cybersec-runtime

# Réseau réservé aux conteneurs nmap/nuclei/http/ping. Le shell n'y est jamais
# connecté : il est systématiquement lancé avec --network=none.
CYBERSEC_SCANNER_NETWORK=mcp-cybersec-scan-network
CYBERSEC_ACTIVITY_MAX_EVENTS=5000
CYBERSEC_ACTIVITY_MAX_AGE_SECONDS=86400

# Ne jamais activer hors recette locale. L'overlay docker-compose.cybersec.lab.yml
# borne le laboratoire à 172.30.0.0/24 et exige laboratory=true dans le mandat.
CYBERSEC_LAB_MODE=false
CYBERSEC_LAB_ALLOWED_CIDRS=
