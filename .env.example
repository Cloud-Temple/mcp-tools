# =============================================================================
# Configuration MCP Tools
# =============================================================================

# --- WAF (Caddy + Coraza) ---
WAF_PORT=8082

# --- Serveur MCP ---
MCP_SERVER_NAME=mcp-tools
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8050
MCP_SERVER_DEBUG=false
# Optional private persistent UTC diagnostic segments. Operator cleanup defaults30d.
TECHNICAL_LOG_DIRECTORY=

# Taille maximale d'une plage de contenu du hub Mission843 (1–30000 octets).
HUB_FILES_PAGE_BYTES=30000

# --- Authentification ---
# Clé utilisée uniquement dans le profil accès S3 ; aucun bypass en profil PG.
ADMIN_BOOTSTRAP_KEY=change_me_in_production

# --- Stockage S3 Dell ECS (Gestion tokens + Tool files) ---
# Dell ECS Cloud Temple : config hybride SigV2/SigV4 automatique
# SigV2 pour données (PUT/GET/DELETE), SigV4 pour métadonnées (HEAD/LIST)
# Le tool files utilise ces valeurs par défaut (overridable par paramètre)
S3_ENDPOINT_URL=https://s3.fr1.cloud-temple.com
S3_ACCESS_KEY_ID=AKIA_YOUR_KEY
S3_SECRET_ACCESS_KEY=your_secret
S3_BUCKET_NAME=mcp-tools
S3_REGION_NAME=fr1

# --- Magasin de tokens : comportement quand S3 tombe ---
# Le magasin échoue en FERMÉ. Quand S3 devient injoignable, le cache déjà
# chargé continue d'être servi pendant TOKEN_STORE_CACHE_TTL +
# TOKEN_STORE_STALE_GRACE, puis l'accès est refusé par un 503. Servir le cache
# sans limite reviendrait à ignorer toute révocation pendant la panne, sans
# qu'aucun signal ne le dise.
#
# TOKEN_STORE_CACHE_TTL=0 interdit de servir depuis le cache, y compris pendant
# une panne, et l'emporte sur fail_open. Coût à connaître : chaque consultation
# de token relit alors S3.
#
# TOKEN_STORE_FAIL_MODE=fail_open lève la fenêtre de grâce et sert le cache
# aussi longtemps que dure la panne. C'est un mode dégradé explicite : les
# révocations sont ignorées tant que S3 n'est pas revenu.
#
# La clé bootstrap reste acceptée pendant une panne, par conception : sans
# elle, la console d'administration et le diagnostic deviendraient
# inaccessibles au moment précis où on en a besoin.
TOKEN_STORE_CACHE_TTL=300
TOKEN_STORE_STALE_GRACE=300
TOKEN_STORE_FAIL_MODE=fail_close

# --- Perplexity ---
# Clé API pour les outils perplexity_*
PERPLEXITY_API_KEY=pplx_...
PERPLEXITY_MODEL=sonar-reasoning-pro
PERPLEXITY_API_URL=https://api.perplexity.ai
# Timeout dédié pour les appels Perplexity API (sonar-reasoning-pro prend 60-120s en detailed)
# PERPLEXITY_TIMEOUT=600

# --- Limites globales d'exécution ---
TOOL_MAX_OUTPUT_CHARS=50000
TOOL_MAX_CONCURRENT=20
TOOL_DEFAULT_TIMEOUT=600    # Timeout par défaut des outils (secondes). Perplexity detailed prend 60-120s.
TOOL_MAX_TIMEOUT=600        # Timeout maximum autorisé

# --- Observabilité (buffer local de /admin et system_activity) ---
# Les événements restent sans payload ni secret. Ces bornes ne remplacent pas
# une archive durable ; elles rendent visible toute éviction locale.
ACTIVITY_MAX_EVENTS=5000
ACTIVITY_MAX_AGE_SECONDS=86400

# --- Sandbox Docker (tool shell) ---
# Image Docker utilisée pour l'exécution isolée des commandes shell
SANDBOX_IMAGE=mcp-tools-sandbox
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=10
SANDBOX_TMPFS_SIZE=32m
SANDBOX_MAX_TIMEOUT=30
# Mettre à false pour exécuter en local (dev sans Docker)
SANDBOX_ENABLED=true
# DNS pour les conteneurs sandbox réseau (séparés par virgule)
# En production Cloud Temple : utiliser le DNS interne
SANDBOX_DNS=8.8.8.8,8.8.4.4

# --- Email (Phase 2 - Optionnel) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=mon_user
# SMTP_PASSWORD=mon_password
# Catalogue files optionnel : S3 contenu, PostgreSQL métadonnées/intents uniques.
# Installation/grants/probe opérateur préalable ; aucun DDL app/fallback.
FILES_METADATA_BACKEND=s3
# Profils PG explicites : compose.postgres.yml force FILES_CREDENTIALS_MODE=vault
# et ACCESS_BACKEND=postgres, sans modifier les défauts historiques ci-dessous.
# Guide : docs/postgres/standalone.md ; opérateur : scripts/prepare_postgres.py
# TOOLS_IMAGE=registry/tools@sha256:DIGEST_APPROUVE
# TOOLS_PG_CA_FILE=/operator/pki/ca.crt
# TOOLS_VAULT_CA_FILE=/operator/trust/vault-ca.pem
# TOOLS_FILES_VAULT_TOKEN_FILE=/operator/scopes/files-app.token
# TOOLS_ACCESS_VAULT_TOKEN_FILE=/operator/scopes/access-app.token
# Override local seulement (une instance, volume persistant, aucune HA/PITR) :
# TOOLS_POSTGRES_IMAGE=postgres@sha256:DIGEST_PG17_APPROUVE
# TOOLS_PG_SERVER_CERT=/operator/pki/server.crt
# TOOLS_PG_SERVER_KEY=/operator/pki/server.key
# TOOLS_PG_INITIAL_PASSWORD_FILE=/operator/pki/initial-password
# TOOLS_PG_HBA_FILE=/operator/pki/pg_hba.conf
FILES_CREDENTIALS_MODE=direct
FILES_PG_SERVICE=tools-app
FILES_PG_DATABASE=tools
FILES_PG_ROLE=tools_files_app
FILES_PG_OWNER=tools_files_owner
FILES_PG_SCHEMA=tools_files
FILES_PG_CA_FILE=
FILES_PG_SYSTEM_IDENTIFIER=
FILES_PG_TIMELINE=1
FILES_DURABILITY=local
FILES_S3_PREFIX=files-generations/
FILES_S3_DATA_SIGNATURE=s3
# Vault-first : renseigner endpoint HTTPS/CA et token privé + coffre Tools propre.
# Secret custom host/port/dbname/user/password ; scopes par job, jamais mount SQL technique Vault.
FILES_VAULT_URL=
FILES_VAULT_ID=
FILES_VAULT_PATH=
FILES_VAULT_TOKEN_FILE=
FILES_VAULT_CA_FILE=

# Autorité accès/activité #31 : sélection explicite, aucun fallback si PG indisponible.
# postgres exige profils/coffres et installation opérateur ; s3 garde le profil historique.
ACCESS_BACKEND=s3
ACCESS_PG_DATABASE=tools
ACCESS_PG_ROLE=tools_access_app
ACCESS_PG_OWNER=tools_access_owner
# Liste exacte des hôtes TLS attendus, ordre primaire libre ; pas de doublon/espace.
ACCESS_PG_HOSTS=
ACCESS_PG_CA_FILE=
ACCESS_OPERATION_TIMEOUT=5
ACCESS_CURSOR_TTL_SECONDS=60
ACCESS_CURSOR_CAPACITY=1024
# URL de base HTTPS du Vault public, sans suffixe /mcp.
ACCESS_VAULT_URL=
ACCESS_VAULT_ID=
ACCESS_VAULT_PATH=connection
ACCESS_VAULT_TOKEN_FILE=
ACCESS_VAULT_CA_FILE=
# #846 : extension holds846, domaine Access neuf seulement, face à un domaine
# Mission coordination_required=true. Preuve Mission : même origine HTTPS.
ACCESS_MISSION_RETENTION_ENABLED=false
ACCESS_RETENTION_ISSUER=
ACCESS_RETENTION_JWKS_URL=
ACCESS_RETENTION_AUDIENCE=
ACCESS_RETENTION_CALLBACK_SECONDS=10

# Délégation hub facultative : destinataire Tools seul, jamais bearer MCP/admin.
HUB_ACTIVITY_ENABLED=false
HUB_ACTIVITY_ISSUER=
HUB_ACTIVITY_AUDIENCE=
HUB_ACTIVITY_OWNER=
HUB_ACTIVITY_JWKS_URL=
HUB_ACTIVITY_CHECK_URL=
HUB_ACTIVITY_CA_FILE=
HUB_ACTIVITY_TIMEOUT_SECONDS=10
HUB_ACTIVITY_MAX_INFLIGHT=16
HUB_ACTIVITY_MAX_BODY_BYTES=8388608
